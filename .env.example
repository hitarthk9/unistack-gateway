# Provider keys — referenced from config.yaml as os.environ/VAR, never written into it.
ANTHROPIC_API_KEY=sk-ant-...

# Admin key for the gateway itself (issuing/revoking virtual keys, the portal).
# Generate one: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-master-change-me

# Postgres backing budgets, virtual keys and the spend ledger.
DATABASE_URL=postgresql://litellm:litellm@localhost:5432/litellm

# Where the security sink POSTs guardrail findings (BUILD_PLAN item 5). unistack-api owns
# MongoDB; the gateway never touches it, which keeps DB credentials out of a container that
# also holds provider API keys. From inside the container the host is `host.docker.internal`.
UNISTACK_API_URL=http://host.docker.internal:8001
# Needs the `security.write` scope — NOT `activity.read`, which must not permit forging findings.
UNISTACK_API_TOKEN=change-me

# Bounds the damage when the API is SLOW rather than down — what fail-open does not cover.
UNISTACK_SINK_TIMEOUT_S=2

# Models exempt from BLOCKING guardrails (comma-separated) — the control plane.
# Both read untrusted agent output, so their prompts contain what a content rule looks for:
#   judge-fast      the SDK's guardrail judge; blocking it fails CLOSED and pauses the activity
#                   with a misleading reason
#   evaluator-fast  Langfuse's forensic quality judges; blocking them means flagged content is
#                   never scored — the worse the output, the less likely it is to be measured
# Non-blocking masking still applies to these models.
UNISTACK_GUARDRAIL_EXEMPT_MODELS=judge-fast,evaluator-fast,projector-fast

# Per-AGENT relaxations of the blocking set, as `key_alias:guardrail` pairs, comma-separated.
# The key alias is the agent's identity (one virtual key per agent — see CLAUDE.md), and it is
# read from the AUTHENTICATED key, never from request metadata, so an agent cannot claim
# another's opt-outs.
#
# Exists because `unistack-no-code-exec` is domain-dependent: a CODING agent's normal traffic is
# exactly what it blocks. Before this, relaxing it meant editing a constant shared by every
# agent on the gateway.
#
# Empty = every agent gets the full blocking set (the default, and the safe one).
# The exempt-model check above always wins, so this can never re-arm a rule on the judge.
UNISTACK_GUARDRAIL_OPT_OUT=
