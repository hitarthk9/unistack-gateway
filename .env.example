# Provider keys — referenced from config.yaml as os.environ/VAR, never written into it.
ANTHROPIC_API_KEY=sk-ant-...

# Admin key for the gateway itself (issuing/revoking virtual keys, the portal).
# Generate one: openssl rand -hex 32
LITELLM_MASTER_KEY=sk-master-change-me

# Postgres backing budgets, virtual keys and the spend ledger.
DATABASE_URL=postgresql://litellm:litellm@localhost:5432/litellm

# Where the security sink POSTs guardrail findings (BUILD_PLAN item 5). unistack-api owns
# MongoDB; the gateway never touches it, which keeps DB credentials out of a container that
# also holds provider API keys. From inside the container the host is `host.docker.internal`.
UNISTACK_API_URL=http://host.docker.internal:8001
# Needs the `security.write` scope — NOT `activity.read`, which must not permit forging findings.
UNISTACK_API_TOKEN=change-me

# Bounds the damage when the API is SLOW rather than down — what fail-open does not cover.
UNISTACK_SINK_TIMEOUT_S=2

# Models exempt from BLOCKING guardrails (comma-separated). The SDK's guardrail judge must be
# here: its prompt contains the agent's raw output, so a content rule would block the judge,
# which fails CLOSED and pauses the activity with a misleading reason. Non-blocking masking
# still applies to these models.
UNISTACK_GUARDRAIL_EXEMPT_MODELS=judge-fast
